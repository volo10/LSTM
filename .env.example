# Environment Configuration Example
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control!

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

# Project name (used in logs and outputs)
PROJECT_NAME=LSTM_Frequency_Extraction

# Environment (development, testing, production)
ENVIRONMENT=development

# =============================================================================
# MODEL TRAINING CONFIGURATION
# =============================================================================

# Device for training (cpu, cuda, mps)
DEVICE=cpu

# Random seed for reproducibility
RANDOM_SEED=42

# Number of training epochs
NUM_EPOCHS=100

# Learning rate
LEARNING_RATE=0.001

# =============================================================================
# DATA CONFIGURATION
# =============================================================================

# Training data seed
TRAIN_SEED=1

# Test data seed
TEST_SEED=2

# Noise standard deviation
NOISE_STD=0.1

# =============================================================================
# API KEYS & SECRETS (if needed for future extensions)
# =============================================================================

# Example: API key for external services (DO NOT commit actual keys!)
# API_KEY=your_api_key_here

# Example: Database credentials (DO NOT commit actual credentials!)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lstm_db
# DB_USER=your_username
# DB_PASSWORD=your_password

# Example: Cloud storage credentials
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your-bucket-name

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable verbose logging
VERBOSE=false

# =============================================================================
# PATHS
# =============================================================================

# Output directory for models
MODEL_OUTPUT_DIR=outputs/models

# Output directory for plots
PLOTS_OUTPUT_DIR=outputs/plots

# Output directory for logs
LOGS_OUTPUT_DIR=outputs/logs

# Output directory for results
RESULTS_OUTPUT_DIR=outputs/results

# =============================================================================
# NOTES
# =============================================================================
#
# Best Practices:
# 1. Copy this file to .env: cp .env.example .env
# 2. Never commit .env to version control (it's in .gitignore)
# 3. Update .env with your actual values
# 4. Use strong, unique passwords for any credentials
# 5. Rotate secrets regularly in production environments
# 6. Use environment-specific .env files (.env.dev, .env.prod)
#
# Loading environment variables in Python:
#   from dotenv import load_dotenv
#   import os
#   load_dotenv()
#   api_key = os.getenv('API_KEY')
#
# =============================================================================
